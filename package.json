{
  "name": "dpl-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/deploy/check-production.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "playwright test",
    "contracts:compile": "hardhat compile",
    "contracts:typecheck": "tsc --project tsconfig.contracts.json",
    "contracts:test": "hardhat test nodejs",
    "contracts:prepare": "node scripts/contracts/prepare.ts",
    "contracts:preflight": "node scripts/contracts/preflight.ts",
    "deploy:local": "npm run contracts:compile && vite --config tools/deploy/vite.config.ts",
    "deploy:test": "node --experimental-strip-types --test tests/deploy/*.test.ts",
    "deploy:test:ui": "playwright test --config playwright.deploy.config.ts",
    "verify:local": "vite --config tools/verify/vite.config.ts",
    "verify:test": "node --experimental-strip-types --test --test-concurrency=1 tests/verify/*.test.ts",
    "verify:test:ui": "playwright test --config playwright.verify.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-ignition": "3.1.9",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "hardhat": "3.21.2",
    "solc": "0.8.38",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "zod": "4.6.7"
  }
}
