{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "hardhat.config.ts",
    "scripts/contracts/**/*.ts",
    "test/contracts/**/*.ts",
    "artifacts/**/*.d.ts",
    "ignition/modules/**/*.ts"
  ]
}
